{
  "name": "browser-bridge",
  "version": "0.8.1",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node -e \"require('@btraut/browser-bridge').startCoreServer().catch((err) => { console.error(err); process.exit(1); });\"",
    "build": "node scripts/build-cli.mjs && node scripts/build-extension.mjs",
    "bump:patch": "node scripts/bump-version.mjs patch && npm install",
    "bump:minor": "node scripts/bump-version.mjs minor && npm install",
    "bump:major": "node scripts/bump-version.mjs major && npm install",
    "tag:version": "node scripts/tag-release.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --max-warnings=0 --fix",
    "typecheck": "tsc -b --pretty false --force",
    "format": "prettier --cache --write .",
    "format:check": "prettier --cache --check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^25.2.0",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "esbuild": "^0.25.9",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
