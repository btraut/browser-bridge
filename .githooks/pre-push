#!/usr/bin/env sh
# bd-shim v1
# bd-hooks-version: 0.49.1
#
# bd (beads) pre-push hook - thin shim
#
# This shim delegates to 'bd hooks run pre-push' which contains
# the actual hook logic. This pattern ensures hook behavior is always
# in sync with the installed bd version - no manual updates needed.
#
# After the beads hook runs, this delegates to the repo pre-push
# script so format/lint/typecheck gates still block bad pushes.

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
hook_script="$repo_root/scripts/git-hooks/pre-push.sh"

if command -v bd >/dev/null 2>&1; then
    export BD_GIT_HOOK=1
    bd hooks run pre-push "$@" || exit $?
else
    echo "Warning: bd not found; skipping beads pre-push tasks" >&2
fi

if [ -x "$hook_script" ]; then
    exec "$hook_script" "$@"
fi

exit 0
